---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 dark:bg-gray-950 text-white py-12 border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <div class="flex items-center space-x-3 mb-4">
          <img src="/logo.webp" alt="Vannabox Logo" class="h-10 w-auto" width="40" height="40" />
          <span class="text-2xl font-bold text-primary-400">Vannabox</span>
        </div>
        <p class="text-gray-300 mb-6 max-w-md text-sm md:text-base leading-relaxed">
          UMKM tambak udang terpercaya di Tegal yang menghadirkan udang segar berkualitas tinggi dengan teknologi modern dan ramah lingkungan.
        </p>
        <div class="flex space-x-3">
          <!-- Facebook SVG -->
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-primary-400 transition-colors p-2 rounded-lg bg-gray-800 hover:bg-gray-700" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <!-- Instagram SVG -->
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-primary-400 transition-colors p-2 rounded-lg bg-gray-800 hover:bg-gray-700" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <!-- WhatsApp SVG -->
          <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-emerald-400 transition-colors p-2 rounded-lg bg-gray-800 hover:bg-gray-700" aria-label="WhatsApp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 2c-5.514 0-9.999 4.486-9.999 10 0 1.765.46 3.488 1.332 5.011l-1.364 4.989 5.107-1.34c1.472.804 3.125 1.229 4.824 1.229 5.515 0 10-4.486 10-10s-4.485-10-10-10zm5.95 14.156c-.247.697-1.442 1.328-1.996 1.378-.506.046-1.168.074-3.754-.997-3.08-1.275-5.074-4.407-5.228-4.613-.153-.207-1.246-1.657-1.246-3.16 0-1.503.784-2.243 1.061-2.551.277-.308.604-.385.805-.385.201 0 .402.002.578.01.188.009.439-.071.688.528.257.616.88 2.146.957 2.302.077.155.129.336.026.542-.103.206-.154.334-.308.514-.154.18-.324.401-.462.538-.154.154-.315.323-.135.632.18.308.799 1.319 1.713 2.133 1.176 1.047 2.167 1.371 2.476 1.525.309.154.489.129.67-.077.18-.206.772-.899.977-1.208.206-.308.411-.257.694-.154.283.103 1.799.848 2.108 1.002.309.154.514.231.591.36.077.129.077.745-.17 1.442z"/>
            </svg>
          </a>
          <!-- YouTube SVG -->
          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-red-400 transition-colors p-2 rounded-lg bg-gray-800 hover:bg-gray-700" aria-label="YouTube">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>
      
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Menu Navigasi</h3>
        <ul class="space-y-2">
          <li><a href="#home" class="text-gray-300 hover:text-primary-400 transition-colors text-sm md:text-base">Beranda</a></li>
          <li><a href="#about" class="text-gray-300 hover:text-primary-400 transition-colors text-sm md:text-base">Tentang Kami</a></li>
          <li><a href="#products" class="text-gray-300 hover:text-primary-400 transition-colors text-sm md:text-base">Katalog Produk</a></li>
          <li><a href="#services" class="text-gray-300 hover:text-primary-400 transition-colors text-sm md:text-base">Layanan & Cold Chain</a></li>
          <li><a href="#contact" class="text-gray-300 hover:text-primary-400 transition-colors text-sm md:text-base">Kontak Pemesanan</a></li>
        </ul>
      </div>
      
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Kontak Layanan</h3>
        <ul class="space-y-3 text-gray-300 text-sm md:text-base">
          <li class="flex items-start">
            <svg class="w-5 h-5 mr-2.5 text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Tegal, Jawa Tengah 52114</span>
          </li>
          <li class="flex items-center">
            <svg class="w-5 h-5 mr-2.5 text-primary-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>+62 812-3456-7890</span>
          </li>
          <li class="flex items-center">
            <svg class="w-5 h-5 mr-2.5 text-primary-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>vannaboxtegal@gmail.com</span>
          </li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-gray-800 mt-8 pt-8 text-center">
      <p class="text-gray-400 text-sm">
        &copy; {currentYear} Vannabox. Semua hak cipta dilindungi. Budidaya Udang Vaname Ramah Lingkungan Tegal.
      </p>
    </div>
  </div>
</footer>
