---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 dark:bg-gray-950 text-white py-12 border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <div class="flex items-center space-x-3 mb-4">
          <img src="/logo.webp" alt="Vannabox Logo" class="h-10 w-auto" width="40" height="40" />
          <span class="text-2xl font-bold text-primary-400">Vannabox</span>
        </div>
        <p class="text-gray-300 mb-6 max-w-md text-sm md:text-base leading-relaxed">
          UMKM tambak udang terpercaya di Tegal yang menghadirkan udang segar berkualitas tinggi dengan teknologi modern dan ramah lingkungan.
        </p>
        <div class="flex space-x-4">
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-primary-400 transition-colors" aria-label="Facebook">
            <i class="fab fa-facebook-f text-xl"></i>
          </a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-primary-400 transition-colors" aria-label="Instagram">
            <i class="fab fa-instagram text-xl"></i>
          </a>
          <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-primary-400 transition-colors" aria-label="WhatsApp">
            <i class="fab fa-whatsapp text-xl"></i>
          </a>
          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-primary-400 transition-colors" aria-label="YouTube">
            <i class="fab fa-youtube text-xl"></i>
          </a>
        </div>
      </div>
      
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Menu</h3>
        <ul class="space-y-2">
          <li><a href="#home" class="text-gray-300 hover:text-primary-400 transition-colors text-sm md:text-base">Beranda</a></li>
          <li><a href="#about" class="text-gray-300 hover:text-primary-400 transition-colors text-sm md:text-base">Tentang</a></li>
          <li><a href="#products" class="text-gray-300 hover:text-primary-400 transition-colors text-sm md:text-base">Produk</a></li>
          <li><a href="#services" class="text-gray-300 hover:text-primary-400 transition-colors text-sm md:text-base">Layanan</a></li>
          <li><a href="#contact" class="text-gray-300 hover:text-primary-400 transition-colors text-sm md:text-base">Kontak</a></li>
        </ul>
      </div>
      
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Kontak</h3>
        <ul class="space-y-2 text-gray-300 text-sm md:text-base">
          <li class="flex items-center">
            <i class="fas fa-map-marker-alt mr-2 text-primary-400"></i>
            Tegal, Jawa Tengah
          </li>
          <li class="flex items-center">
            <i class="fas fa-phone mr-2 text-primary-400"></i>
            +62 812-3456-7890
          </li>
          <li class="flex items-center">
            <i class="fas fa-envelope mr-2 text-primary-400"></i>
            info@vannabox.com
          </li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-gray-800 mt-8 pt-8 text-center">
      <p class="text-gray-400 text-sm">
        &copy; {currentYear} Vannabox. Semua hak cipta dilindungi. | Dibuat untuk UMKM Tambak Udang Indonesia
      </p>
    </div>
  </div>
</footer>
