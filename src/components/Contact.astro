---
// src/components/Contact.astro
---

<section id="contact" class="py-20 bg-gray-50 dark:bg-gray-900 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Hubungi <span class="text-primary-600 dark:text-primary-400">Kami</span>
      </h2>
      <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto leading-relaxed">
        Siap melayani kebutuhan udang segar Anda baik kemasan kotak plastik maupun grosir. Hubungi kami sekarang untuk pemesanan cepat.
      </p>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-12">
      <div>
        <div class="space-y-8">
          <div class="flex items-start space-x-4">
            <div class="bg-primary-100 dark:bg-primary-900/60 p-3.5 rounded-2xl flex-shrink-0 text-primary-600 dark:text-primary-400">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Alamat Tambak & Kantor</h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base leading-relaxed">Jl. Tambak Udang No. 123, Tegal, Jawa Tengah 52114</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="bg-secondary-100 dark:bg-secondary-900/60 p-3.5 rounded-2xl flex-shrink-0 text-secondary-600 dark:text-secondary-400">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Telepon / WhatsApp</h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">+62 812-3456-7890</p>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">+62 283-123-456</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="bg-amber-100 dark:bg-amber-900/60 p-3.5 rounded-2xl flex-shrink-0 text-amber-600 dark:text-amber-400">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Email</h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">vannaboxtegal@gmail.com</p>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">order@vannabox.com</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="bg-blue-100 dark:bg-blue-900/60 p-3.5 rounded-2xl flex-shrink-0 text-blue-600 dark:text-blue-400">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Jam Operasional</h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">Senin - Sabtu: 06:00 - 18:00 WIB</p>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">Minggu: 06:00 - 12:00 WIB</p>
            </div>
          </div>
        </div>
        
        <div class="mt-8">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Saluran Resmi</h3>
          <div class="flex space-x-4">
            <!-- Facebook SVG -->
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-xl transition-colors inline-flex items-center justify-center shadow-md" aria-label="Facebook">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <!-- Instagram SVG -->
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="bg-gradient-to-tr from-amber-500 via-pink-600 to-purple-600 hover:opacity-90 text-white p-3 rounded-xl transition-opacity inline-flex items-center justify-center shadow-md" aria-label="Instagram">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <!-- WhatsApp SVG -->
            <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="bg-emerald-600 hover:bg-emerald-700 text-white p-3 rounded-xl transition-colors inline-flex items-center justify-center shadow-md" aria-label="WhatsApp">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 2c-5.514 0-9.999 4.486-9.999 10 0 1.765.46 3.488 1.332 5.011l-1.364 4.989 5.107-1.34c1.472.804 3.125 1.229 4.824 1.229 5.515 0 10-4.486 10-10s-4.485-10-10-10zm5.95 14.156c-.247.697-1.442 1.328-1.996 1.378-.506.046-1.168.074-3.754-.997-3.08-1.275-5.074-4.407-5.228-4.613-.153-.207-1.246-1.657-1.246-3.16 0-1.503.784-2.243 1.061-2.551.277-.308.604-.385.805-.385.201 0 .402.002.578.01.188.009.439-.071.688.528.257.616.88 2.146.957 2.302.077.155.129.336.026.542-.103.206-.154.334-.308.514-.154.18-.324.401-.462.538-.154.154-.315.323-.135.632.18.308.799 1.319 1.713 2.133 1.176 1.047 2.167 1.371 2.476 1.525.309.154.489.129.67-.077.18-.206.772-.899.977-1.208.206-.308.411-.257.694-.154.283.103 1.799.848 2.108 1.002.309.154.514.231.591.36.077.129.077.745-.17 1.442z"/>
              </svg>
            </a>
            <!-- YouTube SVG -->
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="bg-red-600 hover:bg-red-700 text-white p-3 rounded-xl transition-colors inline-flex items-center justify-center shadow-md" aria-label="YouTube">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
      
      <div class="bg-white dark:bg-gray-800 rounded-3xl p-8 shadow-xl border border-gray-100 dark:border-gray-700">
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Formulir Pemesanan</h3>
        <p class="text-sm md:text-base text-gray-500 dark:text-gray-400 mb-6">
          Isi detail pesanan Anda di bawah ini untuk terhubung langsung dengan admin kami.
        </p>
        
        <!-- Status message container -->
        <div id="form-feedback" class="hidden mb-6 p-4 rounded-xl text-sm font-medium transition-all"></div>

        <form id="contact-form" class="space-y-5">
          <div class="grid md:grid-cols-2 gap-5">
            <div>
              <label for="input-nama" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Nama Lengkap</label>
              <input 
                id="input-nama" 
                name="nama" 
                type="text" 
                required 
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm md:text-base outline-none transition" 
                placeholder="Contoh: Budi Santoso" 
              />
            </div>
            <div>
              <label for="input-telepon" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Nomor Telepon / WhatsApp</label>
              <input 
                id="input-telepon" 
                name="telepon" 
                type="tel" 
                required 
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm md:text-base outline-none transition" 
                placeholder="0812xxxxxxxx" 
              />
            </div>
          </div>

          <div>
            <label for="input-produk" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Pilihan Produk / Paket</label>
            <select 
              id="input-produk" 
              name="produk" 
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm md:text-base outline-none transition"
            >
              <option value="Udang Vaname Kotak Plastik (Rp 35.000 / ±220g Size ~70)" selected>
                Udang Vaname Kotak Plastik (Rp 35.000 / ±220g Size ~70) - Rekomendasi
              </option>
              <option value="Udang Vaname Segar Kiloan (Rp 85.000 / kg Size 70)">
                Udang Vaname Segar Kiloan (Rp 85.000 / Kg Size ~70)
              </option>
              <option value="Pasokan Grosir Tambak (Restoran & Katering)">
                Pasokan Grosir Tambak (Restoran / Hotel / Katering)
              </option>
              <option value="Konsultasi Tambak & Layanan Lainnya">
                Konsultasi & Pertanyaan Lainnya
              </option>
            </select>
          </div>

          <div>
            <label for="input-email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Alamat Email (Opsional)</label>
            <input 
              id="input-email" 
              name="email" 
              type="email" 
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm md:text-base outline-none transition" 
              placeholder="email@anda.com" 
            />
          </div>

          <div>
            <label for="input-pesan" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Catatan Pesanan / Alamat Pengiriman</label>
            <textarea 
              id="input-pesan" 
              name="pesan" 
              rows="3" 
              required 
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm md:text-base outline-none transition" 
              placeholder="Contoh: Pesan 4 kotak plastik vaname, kirim ke Slawi Tegal..."
            ></textarea>
          </div>

          <button 
            type="submit" 
            id="submit-btn" 
            class="w-full bg-primary-600 hover:bg-primary-700 text-white font-bold py-3.5 px-6 rounded-xl transition-all flex items-center justify-center space-x-2 shadow-lg hover:shadow-xl disabled:opacity-50 text-base"
          >
            <svg class="w-5 h-5 mr-2 text-emerald-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.031 2c-5.514 0-9.999 4.486-9.999 10 0 1.765.46 3.488 1.332 5.011l-1.364 4.989 5.107-1.34c1.472.804 3.125 1.229 4.824 1.229 5.515 0 10-4.486 10-10s-4.485-10-10-10zm5.95 14.156c-.247.697-1.442 1.328-1.996 1.378-.506.046-1.168.074-3.754-.997-3.08-1.275-5.074-4.407-5.228-4.613-.153-.207-1.246-1.657-1.246-3.16 0-1.503.784-2.243 1.061-2.551.277-.308.604-.385.805-.385.201 0 .402.002.578.01.188.009.439-.071.688.528.257.616.88 2.146.957 2.302.077.155.129.336.026.542-.103.206-.154.334-.308.514-.154.18-.324.401-.462.538-.154.154-.315.323-.135.632.18.308.799 1.319 1.713 2.133 1.176 1.047 2.167 1.371 2.476 1.525.309.154.489.129.67-.077.18-.206.772-.899.977-1.208.206-.308.411-.257.694-.154.283.103 1.799.848 2.108 1.002.309.154.514.231.591.36.077.129.077.745-.17 1.442z"/>
            </svg>
            <span id="submit-text">Kirim Pesanan ke WhatsApp</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const formFeedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('submit-text');

  if (contactForm && formFeedback && submitBtn && submitText) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const formData = new FormData(contactForm);
      const nama = (formData.get('nama') || '').toString().trim();
      const telepon = (formData.get('telepon') || '').toString().trim();
      const produk = (formData.get('produk') || '').toString().trim();
      const email = (formData.get('email') || '').toString().trim();
      const pesan = (formData.get('pesan') || '').toString().trim();

      if (!nama || !telepon || !pesan) {
        formFeedback.textContent = 'Mohon lengkapi Nama, Nomor Telepon/WhatsApp, dan Catatan Pesanan Anda.';
        formFeedback.className = 'mb-6 p-4 rounded-xl text-sm font-medium bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800';
        formFeedback.classList.remove('hidden');
        return;
      }

      // Format WhatsApp message without emojis
      const waText = encodeURIComponent(
        `Halo Vannabox, saya ingin memesan udang:\n\n` +
        `Nama: ${nama}\n` +
        `WhatsApp: ${telepon}\n` +
        (email ? `Email: ${email}\n` : '') +
        `Produk: ${produk}\n` +
        `Catatan/Alamat: ${pesan}\n\n` +
        `Mohon info ketersediaan stok & ongkirnya ya. Terima kasih!`
      );

      formFeedback.innerHTML = `
        <div class="flex items-start space-x-3">
          <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <div class="flex flex-col space-y-1">
            <p class="font-bold text-emerald-800 dark:text-emerald-200">Pesanan Anda Berhasil Disiapkan</p>
            <p class="text-sm text-emerald-700 dark:text-emerald-300">WhatsApp Anda akan terbuka otomatis untuk terhubung langsung dengan Admin Vannabox.</p>
          </div>
        </div>
      `;
      formFeedback.className = 'mb-6 p-4 rounded-xl text-sm font-medium bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800';
      formFeedback.classList.remove('hidden');

      const waUrl = `https://wa.me/6281234567890?text=${waText}`;
      window.open(waUrl, '_blank');

      contactForm.reset();
    });
  }
</script>
