---
// src/components/Contact.astro
---

<section id="contact" class="py-20 bg-gray-50 dark:bg-gray-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Hubungi <span class="text-primary-600 dark:text-primary-400">Kami</span>
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Siap melayani kebutuhan udang segar Anda. Hubungi kami sekarang untuk konsultasi dan pemesanan.
      </p>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-12">
      <div>
        <div class="space-y-8">
          <div class="flex items-start space-x-4">
            <div class="bg-primary-100 dark:bg-primary-900 p-3 rounded-lg flex-shrink-0">
              <i class="fas fa-map-marker-alt text-xl text-primary-600 dark:text-primary-400"></i>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Alamat</h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">Jl. Tambak Udang No. 123, Tegal, Jawa Tengah 52114</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="bg-secondary-100 dark:bg-secondary-900 p-3 rounded-lg flex-shrink-0">
              <i class="fas fa-phone text-xl text-secondary-600 dark:text-secondary-400"></i>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Telepon</h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">+62 812-3456-7890</p>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">+62 283-123-456</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="bg-yellow-100 dark:bg-yellow-900 p-3 rounded-lg flex-shrink-0">
              <i class="fas fa-envelope text-xl text-yellow-600 dark:text-yellow-400"></i>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Email</h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">info@vannabox.com</p>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">order@vannabox.com</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="bg-blue-100 dark:bg-blue-900 p-3 rounded-lg flex-shrink-0">
              <i class="fas fa-clock text-xl text-blue-600 dark:text-blue-400"></i>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Jam Operasional</h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">Senin - Sabtu: 06:00 - 18:00</p>
              <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base">Minggu: 06:00 - 12:00</p>
            </div>
          </div>
        </div>
        
        <div class="mt-8">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Ikuti Kami</h3>
          <div class="flex space-x-4">
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-lg transition-colors" aria-label="Facebook">
              <i class="fab fa-facebook-f"></i>
            </a>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="bg-pink-600 hover:bg-pink-700 text-white p-3 rounded-lg transition-colors" aria-label="Instagram">
              <i class="fab fa-instagram"></i>
            </a>
            <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="bg-green-600 hover:bg-green-700 text-white p-3 rounded-lg transition-colors" aria-label="WhatsApp">
              <i class="fab fa-whatsapp"></i>
            </a>
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="bg-red-600 hover:bg-red-700 text-white p-3 rounded-lg transition-colors" aria-label="YouTube">
              <i class="fab fa-youtube"></i>
            </a>
          </div>
        </div>
      </div>
      
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg">
        <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Kirim Pesan</h3>
        
        <!-- Status message container -->
        <div id="form-feedback" class="hidden mb-6 p-4 rounded-xl text-sm font-medium transition-all"></div>

        <form id="contact-form" class="space-y-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="input-nama" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Nama</label>
              <input 
                id="input-nama" 
                name="nama" 
                type="text" 
                required 
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm md:text-base outline-none transition" 
                placeholder="Nama lengkap" 
              />
            </div>
            <div>
              <label for="input-telepon" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Telepon</label>
              <input 
                id="input-telepon" 
                name="telepon" 
                type="tel" 
                required 
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm md:text-base outline-none transition" 
                placeholder="Nomor WhatsApp/HP" 
              />
            </div>
          </div>
          <div>
            <label for="input-email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Email</label>
            <input 
              id="input-email" 
              name="email" 
              type="email" 
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm md:text-base outline-none transition" 
              placeholder="Email address (opsional)" 
            />
          </div>
          <div>
            <label for="input-pesan" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Pesan</label>
            <textarea 
              id="input-pesan" 
              name="pesan" 
              rows="4" 
              required 
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm md:text-base outline-none transition" 
              placeholder="Tulis pesan Anda..."
            ></textarea>
          </div>
          <button 
            type="submit" 
            id="submit-btn" 
            class="w-full bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors flex items-center justify-center space-x-2 shadow-md hover:shadow-lg disabled:opacity-50"
          >
            <i class="fas fa-paper-plane mr-2" id="submit-icon"></i>
            <span id="submit-text">Kirim Pesan</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const formFeedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('submit-text');
  const submitIcon = document.getElementById('submit-icon');

  if (contactForm && formFeedback && submitBtn && submitText && submitIcon) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const formData = new FormData(contactForm);
      const nama = (formData.get('nama') || '').toString().trim();
      const telepon = (formData.get('telepon') || '').toString().trim();
      const email = (formData.get('email') || '').toString().trim();
      const pesan = (formData.get('pesan') || '').toString().trim();

      if (!nama || !telepon || !pesan) {
        formFeedback.textContent = 'Mohon lengkapi Nama, Telepon, dan Pesan Anda.';
        formFeedback.className = 'mb-6 p-4 rounded-xl text-sm font-medium bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800';
        formFeedback.classList.remove('hidden');
        return;
      }

      // Success feedback
      formFeedback.innerHTML = `
        <div class="flex flex-col space-y-2">
          <p class="font-semibold text-emerald-800 dark:text-emerald-200">✓ Terima kasih, ${nama}! Pesan Anda telah kami terima.</p>
          <p class="text-xs text-emerald-700 dark:text-emerald-300">Tim Vannabox akan segera menghubungi nomor ${telepon}.</p>
        </div>
      `;
      formFeedback.className = 'mb-6 p-4 rounded-xl text-sm font-medium bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800';
      formFeedback.classList.remove('hidden');

      // Pre-fill WhatsApp message option
      const waText = encodeURIComponent(`Halo Vannabox, saya ${nama} (${telepon})${email ? ' - ' + email : ''}. Pesan saya: ${pesan}`);
      const waUrl = `https://wa.me/6281234567890?text=${waText}`;
      
      // Auto open WhatsApp in background or new tab if user wants direct response
      window.open(waUrl, '_blank');

      contactForm.reset();
    });
  }
</script>
