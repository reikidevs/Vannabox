---
// src/components/Products.astro
const products = [
  {
    id: "vannabox-pack",
    name: "Udang Vaname Kotak Plastik",
    badge: "Produk Utama • Terlaris",
    badgeType: "star",
    badgeColor: "bg-amber-500 text-white",
    image: "/images/vannabox-pack-220g.jpg",
    alt: "Kemasan Udang Vaname Kotak Plastik 220g Vannabox",
    price: "Rp 35.000",
    unit: "/ kotak",
    featured: true,
    specs: [
      { label: "Berat Bersih", value: "±220 Gram" },
      { label: "Estimasi Ukuran", value: "Size ~70 ekor/kg" },
      { label: "Kemasan", value: "Thinwall Food-Grade Kedap Udara" },
      { label: "Kondisi", value: "Segar berpendingin es kristal" },
    ],
    desc: "Pilihan paling praktis untuk kebutuhan dapur keluarga, kuliner rumahan, dan frozen food. Udang vaname segar pilihan dikemas rapi higienis bersama es kristal agar kesegaran tetap terkunci optimal.",
    waText: "Halo Vannabox, saya ingin pesan Udang Vaname Kotak Plastik (Rp 35.000 / 220g Size 70). Berapa minimal order dan bagaimana pengirimannya?",
  },
  {
    id: "vaname-kiloan",
    name: "Udang Vaname Segar Kiloan",
    badge: "Pilihan Favorit",
    badgeType: "check",
    badgeColor: "bg-primary-600 text-white",
    image: "/images/udang-vaname-size-70.jpg",
    alt: "Udang Vaname Segar Size 70 Vannabox Tegal",
    price: "Rp 85.000",
    unit: "/ kg",
    featured: false,
    specs: [
      { label: "Berat", value: "1.000 Gram (1 Kg)" },
      { label: "Estimasi Ukuran", value: "Size ~70 ekor/kg" },
      { label: "Kualitas", value: "Daging kenyal & rasa manis alami" },
      { label: "Sumber", value: "Langsung panen kolam tambak Tegal" },
    ],
    desc: "Udang vaname segar langsung dari kolam tambak budidaya modern di Tegal. Daging padat, bersih, dan manis alami, sangat cocok untuk hidangan seafood istimewa.",
    waText: "Halo Vannabox, saya ingin pesan Udang Vaname Kiloan Size 70 (Rp 85.000 / kg). Mohon info stok hari ini.",
  },
  {
    id: "grosir-restoran",
    name: "Pasokan Grosir Panen Tambak",
    badge: "Restoran & Katering",
    badgeType: "building",
    badgeColor: "bg-secondary-600 text-white",
    image: "/images/panen-tambak-tegal.jpg",
    alt: "Keranjang Panen Udang Tambak Vannabox Tegal",
    price: "Harga Grosir Khusus",
    unit: "Partai Besar",
    featured: false,
    specs: [
      { label: "Kapasitas", value: "Puluhan hingga Ratusan Kg" },
      { label: "Kemasan", value: "Keranjang Panen / Box Insulasi" },
      { label: "Pengiriman", value: "Sistem Cold Chain terjadwal" },
      { label: "Target", value: "Restoran, Rumah Makan, & Agen" },
    ],
    desc: "Solusi pasokan udang segar berkelanjutan untuk hotel, restoran, katering, dan pedagang besar dengan jaminan mutu terstandar dan harga kemitraan terbaik langsung dari petambak.",
    waText: "Halo Vannabox, saya ingin konsultasi kebutuhan pasokan udang segar partai besar / grosir untuk usaha kuliner saya.",
  },
];
---

<section id="products" class="py-20 bg-gray-50 dark:bg-gray-900 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Katalog Produk <span class="text-primary-600 dark:text-primary-400">Vannabox</span>
      </h2>
      <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto leading-relaxed">
        Menghadirkan udang vaname hasil panen tambak Tegal berkualitas prima. Tersedia dalam kemasan kotak plastik higienis siap masak maupun partai kiloan untuk berbagai kebutuhan kuliner.
      </p>
    </div>
    
    <div class="grid lg:grid-cols-3 gap-8 items-stretch">
      {products.map((product) => (
        <div class={`bg-white dark:bg-gray-800 rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 flex flex-col border ${product.featured ? 'border-primary-500 ring-2 ring-primary-500/30' : 'border-gray-200 dark:border-gray-700'}`}>
          <!-- Product Image Container -->
          <div class="relative h-64 overflow-hidden bg-gray-100 dark:bg-gray-900 group">
            <img 
              src={product.image} 
              alt={product.alt} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy"
            />
            <div class="absolute top-4 left-4">
              <span class={`inline-flex items-center px-3.5 py-1.5 rounded-full text-sm font-semibold tracking-wide shadow-md ${product.badgeColor}`}>
                {product.badgeType === 'star' && (
                  <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                )}
                {product.badgeType === 'check' && (
                  <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                )}
                {product.badgeType === 'building' && (
                  <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                )}
                <span>{product.badge}</span>
              </span>
            </div>
          </div>

          <!-- Product Details -->
          <div class="p-6 md:p-8 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
                {product.name}
              </h3>
              
              <p class="text-sm md:text-base text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
                {product.desc}
              </p>

              <!-- Specs Table / Grid -->
              <div class="bg-gray-50 dark:bg-gray-900/60 rounded-2xl p-4 mb-6 border border-gray-100 dark:border-gray-700/60 space-y-2.5">
                {product.specs.map((spec) => (
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-gray-500 dark:text-gray-400 font-medium">{spec.label}</span>
                    <span class="text-gray-900 dark:text-gray-100 font-semibold text-right">{spec.value}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Pricing & Action Button -->
            <div class="pt-4 border-t border-gray-100 dark:border-gray-700 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <span class="text-xs uppercase font-bold tracking-wider text-gray-400 dark:text-gray-400 block mb-1">Harga Resmi</span>
                <div class="flex items-baseline space-x-1">
                  <span class="text-2xl md:text-3xl font-extrabold text-primary-600 dark:text-primary-400">
                    {product.price}
                  </span>
                  <span class="text-sm font-medium text-gray-500 dark:text-gray-400">
                    {product.unit}
                  </span>
                </div>
              </div>

              <a 
                href={`https://wa.me/6281234567890?text=${encodeURIComponent(product.waText)}`}
                target="_blank"
                rel="noopener noreferrer"
                class={`inline-flex items-center justify-center px-6 py-3.5 rounded-xl font-semibold text-sm md:text-base transition-all shadow-md hover:shadow-lg whitespace-nowrap ${product.featured ? 'bg-primary-600 hover:bg-primary-700 text-white' : 'bg-gray-900 dark:bg-gray-700 hover:bg-primary-600 text-white'}`}
              >
                <!-- WhatsApp SVG Icon -->
                <svg class="w-5 h-5 mr-2 text-emerald-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.031 2c-5.514 0-9.999 4.486-9.999 10 0 1.765.46 3.488 1.332 5.011l-1.364 4.989 5.107-1.34c1.472.804 3.125 1.229 4.824 1.229 5.515 0 10-4.486 10-10s-4.485-10-10-10zm5.95 14.156c-.247.697-1.442 1.328-1.996 1.378-.506.046-1.168.074-3.754-.997-3.08-1.275-5.074-4.407-5.228-4.613-.153-.207-1.246-1.657-1.246-3.16 0-1.503.784-2.243 1.061-2.551.277-.308.604-.385.805-.385.201 0 .402.002.578.01.188.009.439-.071.688.528.257.616.88 2.146.957 2.302.077.155.129.336.026.542-.103.206-.154.334-.308.514-.154.18-.324.401-.462.538-.154.154-.315.323-.135.632.18.308.799 1.319 1.713 2.133 1.176 1.047 2.167 1.371 2.476 1.525.309.154.489.129.67-.077.18-.206.772-.899.977-1.208.206-.308.411-.257.694-.154.283.103 1.799.848 2.108 1.002.309.154.514.231.591.36.077.129.077.745-.17 1.442z"/>
                </svg>
                <span>Pesan Sekarang</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Bottom Consultation Banner -->
    <div class="mt-16 bg-gradient-to-r from-primary-600 to-secondary-600 rounded-3xl p-8 md:p-10 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="max-w-2xl">
        <h3 class="text-2xl md:text-3xl font-bold mb-2">Ingin Konsultasi Pemesanan atau Pesanan Khusus?</h3>
        <p class="text-primary-50 text-base md:text-lg">
          Hubungi tim kami langsung melalui WhatsApp untuk mendiskusikan jadwal pengiriman harian, kapasitas suplai restoran, atau permintaan pengemasan khusus.
        </p>
      </div>
      <a 
        href="https://wa.me/6281234567890?text=Halo%20Vannabox%2C%20saya%20ingin%20konsultasi%20pemesanan%20udang%20segar."
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-4 bg-white text-primary-700 hover:bg-primary-50 font-bold rounded-xl transition-all shadow-lg whitespace-nowrap inline-flex items-center flex-shrink-0 text-base"
      >
        <svg class="w-6 h-6 mr-2 text-emerald-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.031 2c-5.514 0-9.999 4.486-9.999 10 0 1.765.46 3.488 1.332 5.011l-1.364 4.989 5.107-1.34c1.472.804 3.125 1.229 4.824 1.229 5.515 0 10-4.486 10-10s-4.485-10-10-10zm5.95 14.156c-.247.697-1.442 1.328-1.996 1.378-.506.046-1.168.074-3.754-.997-3.08-1.275-5.074-4.407-5.228-4.613-.153-.207-1.246-1.657-1.246-3.16 0-1.503.784-2.243 1.061-2.551.277-.308.604-.385.805-.385.201 0 .402.002.578.01.188.009.439-.071.688.528.257.616.88 2.146.957 2.302.077.155.129.336.026.542-.103.206-.154.334-.308.514-.154.18-.324.401-.462.538-.154.154-.315.323-.135.632.18.308.799 1.319 1.713 2.133 1.176 1.047 2.167 1.371 2.476 1.525.309.154.489.129.67-.077.18-.206.772-.899.977-1.208.206-.308.411-.257.694-.154.283.103 1.799.848 2.108 1.002.309.154.514.231.591.36.077.129.077.745-.17 1.442z"/>
        </svg>
        <span>Hubungi WhatsApp Admin</span>
      </a>
    </div>
  </div>
</section>
