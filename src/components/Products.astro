---
// src/components/Products.astro
const products = [
  {
    name: "Udang Vaname",
    desc: "Udang vaname segar dengan ukuran 30-40 ekor per kg, daging kenyal dan rasa manis alami.",
    price: "Rp 85.000/kg",
    gradient: "from-blue-400 to-blue-600"
  },
  {
    name: "Udang Windu",
    desc: "Udang windu premium ukuran jumbo 15-20 ekor per kg, cocok untuk hidangan spesial.",
    price: "Rp 120.000/kg",
    gradient: "from-green-400 to-green-600"
  },
  {
    name: "Udang Galah",
    desc: "Udang galah air tawar dengan rasa gurih khas, ukuran 8-12 ekor per kg.",
    price: "Rp 150.000/kg",
    gradient: "from-purple-400 to-purple-600"
  }
];
---

<section id="products" class="py-20 bg-gray-50 dark:bg-gray-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Produk <span class="text-primary-600 dark:text-primary-400">Unggulan</span>
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Berbagai jenis udang segar berkualitas premium yang siap memenuhi kebutuhan kuliner Anda dengan cita rasa terbaik.
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((product) => (
        <div class="bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <div class={`bg-gradient-to-br ${product.gradient} h-48 flex items-center justify-center`}>
            <i class="fas fa-fish text-6xl text-white"></i>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">{product.name}</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-4">{product.desc}</p>
            <div class="flex items-center justify-between">
              <span class="text-2xl font-bold text-primary-600 dark:text-primary-400">{product.price}</span>
              <a href="#contact" class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg transition-colors inline-flex items-center">
                <i class="fas fa-cart-plus mr-1"></i> Pesan
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="text-center mt-12">
      <a href="#contact" class="inline-flex items-center px-8 py-4 bg-secondary-600 hover:bg-secondary-700 text-white font-semibold rounded-xl transition-colors shadow-lg">
        <i class="fas fa-phone mr-2"></i>
        Konsultasi Pemesanan
      </a>
    </div>
  </div>
</section>
