---
// src/components/Services.astro
const services = [
  {
    icon: "fa-shipping-fast",
    iconBg: "bg-blue-100 dark:bg-blue-900",
    iconColor: "text-blue-600 dark:text-blue-400",
    title: "Pengiriman Cepat",
    desc: "Pengiriman same day untuk area Tegal dan sekitarnya, menjaga kesegaran udang hingga sampai ke tangan Anda."
  },
  {
    icon: "fa-snowflake",
    iconBg: "bg-green-100 dark:bg-green-900",
    iconColor: "text-green-600 dark:text-green-400",
    title: "Cold Chain",
    desc: "Sistem rantai dingin terjaga dari tambak hingga konsumen untuk mempertahankan kualitas dan kesegaran optimal."
  },
  {
    icon: "fa-handshake",
    iconBg: "bg-yellow-100 dark:bg-yellow-900",
    iconColor: "text-yellow-600 dark:text-yellow-400",
    title: "Konsultasi Gratis",
    desc: "Konsultasi gratis untuk pemilihan jenis udang sesuai kebutuhan kuliner dan budget Anda."
  },
  {
    icon: "fa-undo",
    iconBg: "bg-purple-100 dark:bg-purple-900",
    iconColor: "text-purple-600 dark:text-purple-400",
    title: "Garansi Kualitas",
    desc: "Garansi 100% uang kembali jika produk tidak sesuai dengan standar kualitas yang dijanjikan."
  }
];
---

<section id="services" class="py-20 bg-white dark:bg-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Layanan <span class="text-primary-600 dark:text-primary-400">Kami</span>
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Kami menyediakan berbagai layanan terbaik untuk memenuhi kebutuhan udang segar Anda dengan pelayanan profesional.
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {services.map((service) => (
        <div class="text-center group">
          <div class={`${service.iconBg} w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform`}>
            <i class={`fas ${service.icon} text-3xl ${service.iconColor}`}></i>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">{service.title}</h3>
          <p class="text-gray-600 dark:text-gray-300">{service.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
